{
  "name": "gip-transport",
  "version": "1.8.3",
  "description": "Git remote helper for P2P remotes — no server, just peers.",
  "bin": {
    "git-remote-git+pear": "bin.js",
    "git-pear": "bin-tui.js",
    "gip": "bin-tui.js"
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "require": "./index.cjs",
      "import": "./index.mjs"
    }
  },
  "scripts": {
    "test": "brittle-bare test/all.js",
    "format": "prettier . --write",
    "lint": "lunte && prettier . --check",
    "clean": "rm -rf out"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "brittle": "^3.19.1",
    "hyperdht": "^6.33.0",
    "localdrive": "^2.2.1",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0"
  },
  "imports": {
    "buffer": {
      "bare": "bare-buffer",
      "default": "buffer"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "net": {
      "bare": "bare-net",
      "default": "net"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "readline": {
      "bare": "bare-readline",
      "default": "readline"
    },
    "tty": {
      "bare": "bare-tty",
      "default": "tty"
    }
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-buffer": "^3.6.2",
    "bare-console": "^6.2.0",
    "bare-fs": "^4.7.4",
    "bare-http1": "^4.5.7",
    "bare-net": "^2.3.2",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-process": "^4.5.1",
    "bare-readline": "^1.3.1",
    "bare-spinner": "^1.0.2",
    "bare-storage": "^1.1.0",
    "bare-string-decoder": "^1.0.0",
    "bare-subprocess": "^6.1.0",
    "bare-tty": "^5.1.2",
    "bare-ws": "^3.0.0",
    "blind-peering": "^2.5.0",
    "compact-encoding": "^3.3.0",
    "compact-encoding-struct": "^1.3.0",
    "corestore": "^7.11.1",
    "gip-remote": "file:../gip-remote",
    "graceful-goodbye": "^1.3.3",
    "hyperbee2": "^2.11.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdb": "^6.7.0",
    "hyperschema": "^1.21.0",
    "hyperswarm": "^4.17.0",
    "keet-identity-key": "^3.2.0",
    "mirror-drive": "^1.14.2",
    "paparam": "^1.10.1",
    "protomux-wakeup": "^2.9.0",
    "ready-resource": "^1.2.0",
    "rebuild-git": "^1.1.1",
    "sodium-native": "^5.1.0",
    "streamx": "^2.28.0",
    "z32": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/gip-transport.git"
  },
  "bugs": {
    "url": "https://github.com/holepunchto/gip-transport/issues"
  },
  "homepage": "https://github.com/holepunchto/gip-transport#readme"
}
